{
  "version": 1,
  "paths": {
    "/generate-notebook": {
      "name": "/generate-notebook",
      "lambdaFunction": "ainotebookgenerator",
      "permissions": {
        "setting": "private",
        "auth": [
          "create"
        ]
      }
    },
    "/kaggle": {
      "name": "/kaggle",
      "lambdaFunction": "kaggle",
      "permissions": {
        "setting": "open"
      }
    }
  }
}