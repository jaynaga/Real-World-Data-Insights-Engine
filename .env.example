# External Storage Provider OAuth Configuration
# Copy this file to .env and fill in your actual OAuth client IDs

# Google Drive OAuth Configuration
# Get client ID from Google Cloud Console: https://console.cloud.google.com/
REACT_APP_GOOGLE_DRIVE_CLIENT_ID=192100063591-t3fr2ojOu6dble5v7tkje167vko1b0sf.apps.googleusercontent.com

# Dropbox OAuth Configuration  
# Get app key from Dropbox App Console: https://www.dropbox.com/developers/apps
REACT_APP_DROPBOX_CLIENT_ID=xn2mjyuj5yx8lsi

# Microsoft OneDrive OAuth Configuration
# Get client ID from Azure App Registrations: https://portal.azure.com/
REACT_APP_ONEDRIVE_CLIENT_ID=2cbaebe0-e270-4bd9-b5ca-2e76b9c72005

# Instructions:
# 1. Create OAuth applications for each provider you want to support
# 2. Set the redirect URI to: http://localhost:3001/auth-callback.html (for development)
# 3. For production, use: https://your-domain.com/auth-callback.html
# 4. Copy the client IDs from each provider and replace the values above
# 5. Rename this file to .env (remove .example)
