# Environment Configuration for RWDE Platform

Copy this file to `.env.local` and update the values as needed.

# AWS Configuration (handled by Amplify)
# These are automatically configured by aws-exports.js

# Development Settings
REACT_APP_ENVIRONMENT=development

# Feature Flags
REACT_APP_ENABLE_DEBUG=false
REACT_APP_ENABLE_DEMO_MODE=true

# Optional: Custom API URLs (if not using Amplify defaults)
# REACT_APP_API_URL=https://your-api-gateway-url.com
# REACT_APP_BEDROCK_REGION=us-east-1

# Optional: File Upload Limits
REACT_APP_MAX_FILE_SIZE_MB=500
REACT_APP_SUPPORTED_FILE_TYPES=csv,json,xlsx,parquet

# Cloud Storage OAuth Configuration (Legacy - for reference)
# Google Drive API
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here
REACT_APP_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Dropbox API
REACT_APP_DROPBOX_CLIENT_ID=your_dropbox_client_id_here  
REACT_APP_DROPBOX_CLIENT_SECRET=your_dropbox_client_secret_here

# Microsoft OneDrive API
REACT_APP_MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
REACT_APP_MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here

# Kaggle API Configuration
# To get your Kaggle API credentials:
# 1. Go to https://www.kaggle.com/account
# 2. Scroll down to the "API" section
# 3. Click "Create New API Token"
# 4. Download the kaggle.json file
# 5. Copy the username and key from the downloaded file
REACT_APP_KAGGLE_USERNAME=your_kaggle_username
REACT_APP_KAGGLE_KEY=your_kaggle_api_key

# Note: Client secrets should ideally be handled server-side for security
# This is a simplified implementation for demonstration purposes
